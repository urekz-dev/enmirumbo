---
// The global layout of every page (docs/specs/base-layout.md): the document in
// es-MX with its base metadata, the header with the wordmark, the page and the
// footer. It sends no client JavaScript of its own; the only script it may add
// is Umami's, deferred, in production with a Website ID and outside the panel
// and the edit mode (src/lib/analytics.ts).
//
// The locality comes from Astro.locals.locality, which the middleware sets on
// every route under /{estado}/{municipio}/ (ADR 0007), so a page never passes
// it. Without one (the root, /admin, a 404 outside a locality) the layout
// names no locality: the title is the brand alone, there is no site
// description, the wordmark leads to the root and the footer has no
// neighbours line. The root passes whether any locality is active; only the
// root 404 checks that state itself, so the layout adds no database read.
//
// Metadata (docs/specs/base-layout.md, "Every page declares its title,
// description, canonical and share preview (v2)"): a page that may be indexed
// passes `canonicalPath`, its own path, and gets its absolute canonical URL
// and `og:url` from SITE_URL (src/lib/site-url.ts); a 404 or the panel passes
// none. A page that answers but must not be indexed, such as a trade page
// without published cards, passes `noindex`: it gets `<meta name="robots"
// content="noindex, follow">`, so its links are still followed, and no
// canonical. Every page shares its title and description, and the share
// image of its locality or the generic one (src/lib/share-image.ts), with its
// size and alt text; a card with a photo passes its photo as `image` instead
// (src/lib/media.ts). Without a base for absolute URLs, the canonical,
// `og:url` and `og:image` are left out.
//
// The admin panel (everything at `/admin` and below, src/lib/access/
// admin-gate.ts), whose addresses point to a person's registration, and the
// edit mode of the management link (everything at `/{estado}/{municipio}/
// editar/` and below, src/lib/edit-mode.ts), whose address carries the key to
// a card, are decided by where the page lives, not by a prop: their pages,
// their 404 included, declare `noindex, nofollow` and the referrer policy
// `strict-origin`, have no canonical and are never measured (base-layout,
// "Referrer" in "The measurement carries no personal data or text typed by
// people": the policy lives in the trunk of each group).
//
// Measurement: a page may tag its view with one of ANALYTICS_TAGS
// (`analyticsTag`), which the Umami script carries as `data-tag`; with the
// measurement off there is no script, so no tag either.
//
// The body is min-h-dvh, not min-h-full: on Android the browser bar collapses
// while scrolling and the real viewport grows; dvh follows it, so the footer
// always reaches the bottom edge.
import { env } from "cloudflare:workers";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { isAdminRequest } from "../lib/access/admin-gate.ts";
import { pageAnalytics, type AnalyticsTag } from "../lib/analytics.ts";
import { readDeployInfo } from "../lib/deploy-info.ts";
import { EDIT_MODE_REFERRER_POLICY, isEditModeRequest } from "../lib/edit-mode.ts";
import { shareImage, type ShareImage } from "../lib/share-image.ts";
import { documentTitle, SITE_NAME, siteDescription } from "../lib/site.ts";
import { absoluteUrl } from "../lib/site-url.ts";
import "../styles/global.css";

interface Props {
  /** The page's own title; the document shows it as "<title> — enmirumbo". */
  title?: string | undefined;
  /** The page's own description; without it, the site's description in the locality. */
  description?: string | undefined;
  /**
   * The page's own path, such as `/hidalgo/tizayuca`, when search engines may
   * index it: its canonical URL. A 404 or the panel has none.
   */
  canonicalPath?: string | undefined;
  /** Whether search engines must leave the page out; it then has no canonical. */
  noindex?: boolean | undefined;
  /** The tag of this page view (ANALYTICS_TAGS), when the measurement is on. */
  analyticsTag?: AnalyticsTag | undefined;
  /** Whether the footer shows its legal links; root pages pass their active-locality state. */
  showLegalLinks?: boolean | undefined;
  /**
   * The page's own share image, with an absolute `src`, instead of its
   * locality's: a card's photo.
   */
  image?: ShareImage | undefined;
}

const {
  title,
  description,
  canonicalPath,
  noindex: noindexProp = false,
  analyticsTag,
  showLegalLinks: showLegalLinksProp = true,
  image: ownImage,
} = Astro.props;
// The panel and the edit mode: never indexed nor followed, and no path leaves
// as a referrer.
const closed =
  isAdminRequest(Astro.url, Astro.routePattern) || isEditModeRequest(Astro.url, Astro.routePattern);
const noindex = noindexProp || closed;
const locality = Astro.locals.locality;
const pageTitle = documentTitle(title, locality);
const metaDescription = description ?? siteDescription(locality);
const canonical = canonicalPath === undefined || noindex ? null : absoluteUrl(env, canonicalPath);
const image = ownImage ?? shareImage(locality);
const imageUrl = ownImage ? ownImage.src : absoluteUrl(env, image.src);
const analytics = pageAnalytics(env, Astro.url, Astro.routePattern);
const deploy = readDeployInfo(env);
---

<!doctype html>
<html lang="es-MX" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Only the explicit tel: links call; numbers in the text stay text. */}
    <meta name="format-detection" content="telephone=no" />
    <title>{pageTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    {noindex && <meta name="robots" content={closed ? "noindex, nofollow" : "noindex, follow"} />}
    {closed && <meta name="referrer" content={EDIT_MODE_REFERRER_POLICY} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={pageTitle} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {imageUrl && (
      <>
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:type" content={image.type} />
        <meta property="og:image:width" content={String(image.width)} />
        <meta property="og:image:height" content={String(image.height)} />
        <meta property="og:image:alt" content={image.alt} />
      </>
    )}
    {analytics && (
      <script
        is:inline
        defer
        src={analytics.scriptUrl}
        data-website-id={analytics.websiteId}
        data-exclude-search="true"
        data-tag={analyticsTag}
      ></script>
    )}
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col bg-background font-sans text-ink">
    <SiteHeader locality={locality} />
    <main class="mx-auto flex w-full max-w-3xl flex-1 flex-col px-4 py-8 sm:px-6">
      <slot />
    </main>
    <SiteFooter locality={locality} deploy={deploy} showLegalLinks={showLegalLinksProp} />
  </body>
</html>
