---
// The unpublishing form of a published card (docs/specs/admin-review.md,
// "Unpublish a published card, with a mandatory reason and conditioned on the
// status"): the reason, required, under "¿Por qué la despublicas?", with
// "Este motivo se le enviará al negocio por WhatsApp." next to the label, so
// an internal note does not reach a third party by accident, and
// "Despublicar". It posts to the detail's own address with the action
// `admin.unpublish`. After an error the reason comes back exactly as it was
// typed, next to its error. Like the rejection's, the field has no
// `maxlength`, which would cut a pasted text without a word: the server
// refuses one over 500 characters instead. Every check is the server's, so
// the form is `novalidate`. No client JavaScript.
import { REASON_MAX_LENGTH, type ReasonError } from "../../core/review/reason.ts";
import {
  reasonTooLongText,
  UNPUBLISH_BUTTON,
  UNPUBLISH_HEADING,
  UNPUBLISH_QUESTION,
  UNPUBLISH_REASON_HINT,
  UNPUBLISH_REASON_REQUIRED,
} from "../../core/review/texts.ts";
import { UNPUBLISH_FIELD } from "../../core/review/unpublish.ts";
import { SECONDARY_BUTTON } from "../../lib/buttons.ts";
import FieldError from "../FieldError.astro";

interface Props {
  /** The address the form posts to: the detail with the action `admin.unpublish`. */
  action: string;
  /** The reason as it was typed in the last submission; empty otherwise. */
  reason: string;
  error: ReasonError | null;
}

const { action, reason, error } = Astro.props;
const message =
  error === "required"
    ? UNPUBLISH_REASON_REQUIRED
    : error === "too-long"
      ? reasonTooLongText(REASON_MAX_LENGTH)
      : null;
const described = error ? "unpublish-reason-hint unpublish-reason-error" : "unpublish-reason-hint";
const control =
  "w-full rounded-lg bg-background px-4 py-3 text-base text-ink focus:ring-2 focus:ring-action-strong focus:outline-none";
---

<form
  method="post"
  action={action}
  novalidate
  class="flex flex-col gap-3 rounded-xl border border-line p-4"
  data-testid="unpublish-form"
>
  <h2 class="font-semibold text-ink">{UNPUBLISH_HEADING}</h2>

  <div class="flex flex-col gap-1.5">
    <label for="unpublish-reason" class="text-sm font-semibold text-ink">
      {UNPUBLISH_QUESTION}
    </label>
    <p id="unpublish-reason-hint" class="text-sm text-ink-muted">
      {UNPUBLISH_REASON_HINT}
    </p>
    <textarea
      id="unpublish-reason"
      name={UNPUBLISH_FIELD}
      rows="3"
      aria-invalid={error ? "true" : undefined}
      aria-describedby={described}
      class={error ? `${control} border-2 border-ink` : `${control} border border-control`}
    >{reason}</textarea>
    <FieldError id="unpublish-reason-error" message={message} />
  </div>

  <button type="submit" class={`${SECONDARY_BUTTON} w-full px-4 text-base`}>
    {UNPUBLISH_BUTTON}
  </button>
</form>
