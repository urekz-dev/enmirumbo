---
interface Props {
  name: string;
  label: string;
  value?: string;
  error?: string | undefined;
  type?: "text" | "email";
}
const { name, label, value = "", error, type = "text" } = Astro.props;
---

<div class="flex flex-col gap-2">
  <label for={name} class="font-semibold">
    {label}
  </label>
  <input
    id={name}
    name={name}
    type={type}
    value={value}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={error ? `${name}-error` : undefined}
    class="min-h-11 w-full min-w-0 rounded-lg border border-line bg-background px-3 py-2"
  />
  {error && (
    <p id={`${name}-error`} role="alert" class="text-sm font-semibold text-ink">
      {error}
    </p>
  )}
</div>
