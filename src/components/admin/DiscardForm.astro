---
// The discard form of a pending edit (docs/specs/admin-review.md,
// "Discarding the pending edit requires a reason, does not touch the card
// and offers to notify by WhatsApp"): the reason, required, under "¿Por qué
// no aplicas los cambios?", and "Descartar los cambios". It posts to the
// detail's own address with the action `admin.discardEdit`. After an error
// the reason comes back exactly as it was typed, next to its error. Like the
// rejection's, the field has no `maxlength`: a browser cuts a pasted text at
// it without a word, and the reason travels whole to the business, so the
// server refuses one over 500 characters instead, and the admin shortens it.
// Every check is the server's, so the form is `novalidate`. No client
// JavaScript.
import { DISCARD_FIELD } from "../../core/review/discard.ts";
import { REASON_MAX_LENGTH, type ReasonError } from "../../core/review/reason.ts";
import {
  DISCARD_BUTTON,
  DISCARD_HEADING,
  DISCARD_REASON_LABEL,
  DISCARD_REASON_REQUIRED,
  reasonTooLongText,
} from "../../core/review/texts.ts";
import { SECONDARY_BUTTON } from "../../lib/buttons.ts";
import FieldError from "../FieldError.astro";

interface Props {
  /** The address the form posts to: the detail with the action `admin.discardEdit`. */
  action: string;
  /** The reason as it was typed in the last submission; empty otherwise. */
  reason: string;
  error: ReasonError | null;
}

const { action, reason, error } = Astro.props;
const message =
  error === "required"
    ? DISCARD_REASON_REQUIRED
    : error === "too-long"
      ? reasonTooLongText(REASON_MAX_LENGTH)
      : null;
const control =
  "w-full rounded-lg bg-background px-4 py-3 text-base text-ink focus:ring-2 focus:ring-action-strong focus:outline-none";
---

<form
  method="post"
  action={action}
  novalidate
  class="flex flex-col gap-3 rounded-xl border border-line p-4"
  data-testid="discard-form"
>
  <h2 class="font-semibold text-ink">{DISCARD_HEADING}</h2>

  <div class="flex flex-col gap-1.5">
    <label for="discard-reason" class="text-sm font-semibold text-ink">
      {DISCARD_REASON_LABEL}
    </label>
    <textarea
      id="discard-reason"
      name={DISCARD_FIELD}
      rows="3"
      aria-invalid={error ? "true" : undefined}
      aria-describedby={error ? "discard-reason-error" : undefined}
      class={error ? `${control} border-2 border-ink` : `${control} border border-control`}
    >{reason}</textarea>
    <FieldError id="discard-reason-error" message={message} />
  </div>

  <button type="submit" class={`${SECONDARY_BUTTON} w-full px-4 text-base`}>
    {DISCARD_BUTTON}
  </button>
</form>
