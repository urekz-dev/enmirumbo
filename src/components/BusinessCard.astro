---
// The body of a business's card (docs/specs/public-directory.md, "Business
// card at its own URL with the registered information and the verified
// seal", "The zone is published, never the exact address nor the card's
// internal data" and "Contact buttons on the card with WhatsApp as the main
// action"), in the prototype's order: the photo, the name as the only `h1`,
// the seal and the "A domicilio" tag, the zone, what it offers, its address or
// references, its opening hours, a landline that cannot be dialled, its
// trades, the contact block and, apart from it, "Reportar este negocio" and
// "¿Es tu negocio?" with "Perdí mi enlace" (CardSecondaryLinks.astro).
//
// A field the business did not register is not drawn at all: no empty label,
// no "No disponible". Everything shown is what the business wrote, as it
// wrote it, never completed with other data. Text written by the business
// wraps (`break-words`), so a very long word cannot scroll a 390px phone
// sideways.
//
// The photo ("The card shows the business photo when it has one") is its
// 1200×900 `full` variant, larger than the listing card's, from the address
// src/lib/media.ts builds from the stored key, announced as "Foto de
// <nombre>"; its box keeps the photo's proportion before it loads, so nothing
// moves. A card without a photo, or whose stored value is not a key the
// server generated, shows no gap, frame or text about one.
// No client JavaScript.
import { env } from "cloudflare:workers";
import type { PublishedCard } from "../core/business/card.ts";
import { callLink } from "../core/business/contact.ts";
import type { ServedLocality } from "../core/locality/served.ts";
import type { Analytics } from "../lib/analytics.ts";
import { businessPhoto } from "../lib/media.ts";
import CardSecondaryLinks from "./CardSecondaryLinks.astro";
import CardTrades from "./CardTrades.astro";
import ContactButtons from "./ContactButtons.astro";
import HomeDeliveryTag from "./HomeDeliveryTag.astro";
import VerifiedSeal from "./VerifiedSeal.astro";

interface Props {
  card: PublishedCard;
  locality: ServedLocality;
  analytics: Analytics | null;
}

const { card, locality, analytics } = Astro.props;
// Registered, but not a number one can dial: shown as written, with no
// "Llamar" (no hostile dialing code reaches a tel: link).
const undialableLandline = card.landline !== null && callLink(card.landline) === null;
const photo = businessPhoto(env, card.photoKey, "full");
---

<article class="flex flex-col gap-6 py-4">
  {photo && (
    <img
      src={photo.src}
      width={photo.width}
      height={photo.height}
      alt={`Foto de ${card.name}`}
      decoding="async"
      class="aspect-4/3 w-full rounded-xl bg-surface object-cover"
    />
  )}
  <div class="flex flex-col gap-2">
    <h1 class="text-2xl font-bold tracking-tight break-words sm:text-3xl">{card.name}</h1>
    <div class="flex flex-wrap items-center gap-2">
      <VerifiedSeal />
      {card.homeDelivery && <HomeDeliveryTag />}
    </div>
    {card.zoneName && <p class="break-words text-ink-muted">{card.zoneName}</p>}
  </div>

  {card.whatYouOffer && <p class="break-words text-ink">{card.whatYouOffer}</p>}

  {card.address && <p class="break-words text-ink-muted">{card.address}</p>}

  {card.openingHours && (
    <p class="break-words text-ink-muted">
      <span class="font-semibold text-ink">Horario: </span>
      {card.openingHours}
    </p>
  )}

  {undialableLandline && (
    <p class="break-words text-ink-muted">
      <span class="font-semibold text-ink">Teléfono: </span>
      {card.landline}
    </p>
  )}

  <CardTrades trades={card.trades} locality={locality} />

  <ContactButtons card={card} locality={locality} analytics={analytics} />

  <CardSecondaryLinks card={card} locality={locality} />
</article>
