---
// The global footer (docs/specs/base-layout.md, "Global layout with header and
// footer on every page"): the brand alone, the line for the neighbours of the
// locality, read from the locality record (PRD §5), and, when enabled, links
// to the two legal pages, each with a touch area of at least 44px. Outside a
// locality there is no locality to name, so the neighbours line is left out (v2).
// While another locality is active too, a page of a locality offers to change
// municipality with a link to the list (docs/specs/public-directory.md, "The
// pages of a locality offer to change municipality while two or more are
// active (v2)"). On dev it also names the branch and commit deployed
// (docs/specs/deployment.md, "The dev footer names the branch and commit
// deployed (v2)"). No client JavaScript.
import { CHANGE_LOCALITY_PATH } from "../core/locality/paths.ts";
import type { ServedLocality } from "../core/locality/served.ts";
import type { DeployInfo } from "../lib/deploy-info.ts";

interface Props {
  locality: ServedLocality | undefined;
  deploy: DeployInfo | undefined;
  showLegalLinks: boolean;
}

const { locality, deploy, showLegalLinks } = Astro.props;
---

<footer class="border-t border-line bg-surface">
  <div class="mx-auto flex w-full max-w-3xl flex-col gap-1 px-4 py-6 text-sm text-ink-muted sm:px-6">
    <p class="font-semibold text-ink">enmirumbo</p>
    {locality && (
      <p data-testid="neighbours-line">
        Hecho para los vecinos de {locality.name}, {locality.state.name}.
      </p>
    )}
    {locality?.othersActive && (
      <a
        href={CHANGE_LOCALITY_PATH}
        class="inline-flex min-h-11 items-center self-start font-semibold text-ink underline underline-offset-4"
      >
        Cambiar de municipio
      </a>
    )}
    {showLegalLinks && (
      <nav aria-label="Enlaces legales" class="mt-2 flex flex-wrap gap-x-4">
        <a
          href="/aviso-de-privacidad"
          class="inline-flex min-h-11 items-center text-ink underline underline-offset-4"
        >
          Aviso de privacidad
        </a>
        <a
          href="/terminos"
          class="inline-flex min-h-11 items-center text-ink underline underline-offset-4"
        >
          Términos y condiciones
        </a>
      </nav>
    )}
    {deploy && (
      <p class="mt-2 break-all" data-testid="deploy-info">
        Versión de prueba: rama <code>{deploy.branch}</code>, commit{" "}
        <code title={deploy.commit}>{deploy.shortCommit}</code>
      </p>
    )}
  </div>
</footer>
