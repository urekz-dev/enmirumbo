---
// The confirmation of a rejection, at /admin/registros/<id>/rechazado
// (docs/specs/admin-review.md, "Rejecting requires a reason, stores it with
// its date and offers to notify by WhatsApp" and "A transition is only
// applied to a registration that is still in review"): where a rejection
// answers with a 303, so reloading it never rejects again. "Registro
// rechazado." and "Avisarle por WhatsApp" with the reason stored, never one
// an address carries. It exists only for a rejection that happened: a card
// that is not rejected, has no reason, does not exist, or that the user may
// not review goes back to the detail, which answers for itself (a 404 for a
// card the user may not see), with nothing of the card in this answer. It
// reads through HYPERDRIVE_FRESH, behind the panel's Access check, headers
// and layout rules, and answers any method but GET or HEAD with a 405.
import { env, waitUntil } from "cloudflare:workers";
import RejectionConfirmation from "../../../../components/admin/RejectionConfirmation.astro";
import { withDb } from "../../../../core/db/client.ts";
import { queuePath, registrationPath } from "../../../../core/review/paths.ts";
import { rejectionNotice } from "../../../../core/review/rejection.ts";
import { REJECTED } from "../../../../core/review/texts.ts";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { forbiddenResponse } from "../../../../lib/access/admin-gate.ts";
import { seeOther } from "../../../../lib/locality.ts";

const admin = Astro.locals.admin;
// Second line of defense: never render the panel without an identity.
if (admin === undefined) return forbiddenResponse();
if (Astro.request.method !== "GET" && Astro.request.method !== "HEAD") {
  return new Response(null, { status: 405, headers: { Allow: "GET, HEAD" } });
}

const businessId = Astro.params.id ?? "";
const notice = await withDb(env, "HYPERDRIVE_FRESH", { waitUntil }, (db) =>
  rejectionNotice(db, { email: admin.email, businessId }),
);
if (notice === null) return seeOther(registrationPath(businessId));
---

<BaseLayout title={REJECTED}>
  <RejectionConfirmation
    name={notice.name}
    whatsapp={notice.whatsapp}
    reason={notice.reason}
    queueHref={queuePath()}
  />
</BaseLayout>
