---
import { actions } from "astro:actions";
import { env, waitUntil } from "cloudflare:workers";
import { can } from "../../../core/access/queries.ts";
import { panelHome } from "../../../core/access/home.ts";
import { panelUsers } from "../../../core/access/manage.ts";
import { userPath } from "../../../core/access/paths.ts";
import { withDb } from "../../../core/db/client.ts";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PanelNavigation from "../../../components/admin/PanelNavigation.astro";
import UsersScreen from "../../../components/admin/UsersScreen.astro";
import { forbiddenResponse } from "../../../lib/access/admin-gate.ts";
import { notFound, seeOther } from "../../../lib/locality.ts";
import {
  managementFailure,
  managementForm,
  managementStatus,
  typedManagementText,
} from "../../../lib/panel-management.ts";
const admin = Astro.locals.admin;
if (!admin) return forbiddenResponse();
if (!["GET", "HEAD", "POST"].includes(Astro.request.method))
  return new Response(null, { status: 405, headers: { Allow: "GET, HEAD, POST" } });
const result = Astro.getActionResult(actions.admin.createUser);
if (result?.error?.code === "FORBIDDEN") return forbiddenResponse();
if (result?.error?.code === "NOT_FOUND") return notFound();
const view = await withDb(env, "HYPERDRIVE_FRESH", { waitUntil }, async (db) => {
  if (!(await can(db, admin.email, "users.manage", null))) return null;
  return { users: await panelUsers(db), home: await panelHome(db, admin.email) };
});
if (!view) return forbiddenResponse();
if (result?.data?.kind === "done") return seeOther(userPath(String(result.data.id)));
Astro.response.status = managementStatus(result);
const form = await managementForm(Astro.request);
---

<BaseLayout title="Usuarios del panel">
  <div class="flex flex-col gap-6">
    <PanelNavigation links={view.home?.links ?? []} />
    <UsersScreen
      users={view.users}
      action={actions.admin.createUser.queryString}
      failure={managementFailure(result)}
      values={{
        email: typedManagementText(form, "email"),
        name: typedManagementText(form, "name"),
      }}
    />
  </div>
</BaseLayout>
