---
// The panel entry at /admin: the queue, or a home for other assigned users.
// (docs/specs/admin-review.md, "Review queue with the pending registrations,
// oldest first", "Visible indicator for registrations waiting more than 48
// hours", "The queue tells which businesses have unattended reports", "The
// queue has a visible entry to the listing, and the listing returns to the
// queue", "The panel filters by locality, and the filter is hidden while
// there is one (v2)" and "Each review screen checks its permission in the
// locality of what it shows (v2)").
//
// src/middleware.ts has already verified the Access token and set
// Astro.locals.admin, and marked the response as not indexable and not
// cacheable; the layout declares `noindex, nofollow` and the panel's
// referrer policy, and no analytics, by where the page lives. Then the page:
//
// 1. Reads what the user may see (src/core/review/scope.ts), through
//    HYPERDRIVE_FRESH: unknown, inactive and unassigned users get 403; an
//    assigned user without queue permissions gets the permitted sections.
// 2. Narrows it with the locality filter, `?localidad=`, shown only while
//    the user sees two or more active localities.
// 3. Reads "Registros por revisar" and "Negocios reportados" of those
//    localities, with the clock of this request, and the display names of
//    their zones.
// 4. Offers "Administrar colonias" to a user who manages the zones of a
//    locality (src/core/zones/scope.ts).
import { env, waitUntil } from "cloudflare:workers";
import PanelHome from "../../components/admin/PanelHome.astro";
import PanelNavigation from "../../components/admin/PanelNavigation.astro";
import { rolesPath, usersPath } from "../../core/access/paths.ts";
import { panelHome } from "../../core/access/home.ts";
import ReviewQueue from "../../components/admin/ReviewQueue.astro";
import { withDb } from "../../core/db/client.ts";
import {
  chosenLocality,
  localityFilterOptions,
  panelLocalities,
  withZoneNames,
  zoneNamesByLocality,
} from "../../core/review/localities.ts";
import { businessesPath, queuePath } from "../../core/review/paths.ts";
import { reportedBusinesses, reviewQueue } from "../../core/review/queue.ts";
import { narrowScope, panelScope, queueLocalities } from "../../core/review/scope.ts";
import { zonesPath } from "../../core/zones/paths.ts";
import { zonesLocalities } from "../../core/zones/scope.ts";
import {
  ALL_LOCALITIES,
  FILTER_BY_LOCALITY,
  localityText,
  QUEUE_HEADING,
} from "../../core/review/texts.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { forbiddenResponse } from "../../lib/access/admin-gate.ts";

const admin = Astro.locals.admin;
// Second line of defense: never render the panel without an identity.
if (admin === undefined) return forbiddenResponse();

const now = new Date();
const view = await withDb(env, "HYPERDRIVE_FRESH", { waitUntil }, async (db) => {
  const home = await panelHome(db, admin.email);
  if (home === null) return null;
  const scope = await panelScope(db, admin.email);
  const seen = await panelLocalities(db, queueLocalities(scope));
  if (seen.length === 0) return { kind: "home" as const, home };
  const options = localityFilterOptions(seen);
  const chosen = chosenLocality(Astro.url.searchParams.getAll("localidad"), options);
  const narrowed = narrowScope(scope, chosen);
  const zoneNames = await zoneNamesByLocality(db, seen);
  const rows = withZoneNames(await reviewQueue(db, narrowed, now), zoneNames);
  const reported = await reportedBusinesses(db, narrowed.reports);
  const zoneLocalities = (await zonesLocalities(db, admin.email)).map(({ code }) => code);
  const zonesHref =
    zoneLocalities.length === 0
      ? null
      : zonesPath(chosen !== null && zoneLocalities.includes(chosen) ? chosen : null);
  return { kind: "queue" as const, home, scope, seen, options, chosen, rows, reported, zonesHref };
});
if (view === null) return forbiddenResponse();

const queueView = view.kind === "queue" ? view : null;
const { scope, seen, options, chosen, rows, reported, zonesHref } = queueView ?? {
  scope: { cards: [] },
  seen: [],
  options: [],
  chosen: null,
  rows: [],
  reported: [],
  zonesHref: null,
};
const localityFilter =
  options.length === 0
    ? []
    : [
        { text: ALL_LOCALITIES, href: queuePath(), current: chosen === null },
        ...options.map((locality) => ({
          text: localityText(locality),
          href: queuePath(locality.code),
          current: chosen === locality.code,
        })),
      ];
const localityNames =
  options.length === 0 || chosen !== null
    ? null
    : new Map(seen.map((locality) => [locality.code, localityText(locality)]));
---

<BaseLayout title={queueView ? QUEUE_HEADING : "Panel de enmirumbo"}>
  {queueView ? (
    <div class="flex flex-col gap-6">
      <PanelNavigation
        links={view.home.links.filter(
          (link) => link.href === usersPath() || link.href === rolesPath(),
        )}
      />
      <ReviewQueue
        rows={rows}
        reported={reported}
        now={now}
        localityFilter={localityFilter}
        localityFilterLabel={FILTER_BY_LOCALITY}
        localityNames={localityNames}
        listHref={scope.cards.length > 0 ? businessesPath({ locality: chosen }) : null}
        zonesHref={zonesHref}
      />
    </div>
  ) : (
    <PanelHome links={view.home.links} />
  )}
</BaseLayout>
