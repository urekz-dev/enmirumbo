---
// The confirmation of an applied edit, at /admin/ediciones/<id>/aplicada
// (docs/specs/admin-review.md, "Applying the pending edit updates the
// published card and only that", "A pending edit is resolved only once and
// only if it is still the latest" and "Attending a report and resolving a
// pending edit are forms of their details, and their action checks
// everything again (v2)"): where an apply answers with a 303, so reloading
// it never applies again. "Listo, la ficha ya se actualizó.", that the site
// takes up to a minute to show it, and "Avisarle por WhatsApp" with the
// card's public address, absolute from SITE_URL. It exists only for an edit
// that was applied, whose card is still published, and that the user may
// resolve: any other goes back to the detail of the edit, which answers for
// itself (a 404 for an edit the user may not see), with nothing of the card
// in this answer. It reads through HYPERDRIVE_FRESH, behind the panel's
// Access check, headers and layout rules, and answers any method but GET or
// HEAD with a 405.
import { env, waitUntil } from "cloudflare:workers";
import AppliedConfirmation from "../../../../components/admin/AppliedConfirmation.astro";
import { withDb } from "../../../../core/db/client.ts";
import { appliedNotice } from "../../../../core/review/apply.ts";
import { editPath, queuePath } from "../../../../core/review/paths.ts";
import { EDIT_APPLIED } from "../../../../core/review/texts.ts";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { forbiddenResponse } from "../../../../lib/access/admin-gate.ts";
import { appliedCardUrl } from "../../../../lib/edit-review.ts";
import { seeOther } from "../../../../lib/locality.ts";

const admin = Astro.locals.admin;
// Second line of defense: never render the panel without an identity.
if (admin === undefined) return forbiddenResponse();
if (Astro.request.method !== "GET" && Astro.request.method !== "HEAD") {
  return new Response(null, { status: 405, headers: { Allow: "GET, HEAD" } });
}

const editId = Astro.params.id ?? "";
const notice = await withDb(env, "HYPERDRIVE_FRESH", { waitUntil }, (db) =>
  appliedNotice(db, { email: admin.email, editId }),
);
if (notice === null) return seeOther(editPath(editId));
---

<BaseLayout title={EDIT_APPLIED}>
  <AppliedConfirmation
    name={notice.name}
    whatsapp={notice.whatsapp}
    cardUrl={appliedCardUrl(env, notice)}
    queueHref={queuePath()}
  />
</BaseLayout>
