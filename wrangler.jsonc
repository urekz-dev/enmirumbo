// The top level is the local Worker (`vp run dev`, `vp run preview`, the
// tests). The deployed environments dev, stage and prod live under "env"
// (ADR 0008), and each declares its own bindings, vars and triggers: Wrangler
// does not inherit bindings or vars, and nothing is declared at the top level
// for an environment to inherit by accident. Build for an environment with
// `CLOUDFLARE_ENV=<env> vp run build`; the deploy workflows in
// .github/workflows/ are the only way to deploy.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Local name only. Each environment sets its own Worker name, so a deploy
  // without an environment never touches dev-enmirumbo, stage-enmirumbo or
  // enmirumbo.
  "name": "enmirumbo-local",
  // Custom entry: Astro's fetch handler plus the scheduled handler.
  "main": "./src/worker.ts",
  // Node.js compatibility is on by default from 2026-08-04.
  "compatibility_date": "2026-10-01",
  // The local Worker is never deployed. If it were, by mistake, it would get no
  // workers.dev URL and no Version URLs. The environments turn workers.dev on.
  // `preview_urls` stays false here and in every environment, each writing it
  // (ADR 0012, amended on 2026-10-15; test/scripts/quota-guardrails.test.ts).
  "workers_dev": false,
  "preview_urls": false,
  // Workers Logs and traces stay off, here and in every environment, each
  // writing it (docs/specs/deployment.md, "Workers Logs and traces stay off in
  // every environment (v2)"): an invocation log keeps the URL of each request,
  // and the edit mode's URL carries the key to a card. Debugging uses
  // `wrangler tail`, which is live and keeps nothing.
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false, "persist": false },
    "traces": { "enabled": false, "persist": false },
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  // Local values. The all-zero id is a placeholder and `localConnectionString`
  // points both bindings at the PostgreSQL 18 in compose.yaml (`vp run db:up`).
  // HYPERDRIVE is cached: public reads only. HYPERDRIVE_FRESH has caching
  // disabled: writes, the admin panel and any read that follows a write.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://enmirumbo:enmirumbo@localhost:5432/enmirumbo",
    },
    {
      "binding": "HYPERDRIVE_FRESH",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://enmirumbo:enmirumbo@localhost:5432/enmirumbo",
    },
  ],
  // The per-IP quotas (ADR 0012, src/lib/quota/): one single Durable Object
  // for every purpose, which keeps its counters and the key of its codes in
  // memory and never writes to its storage. Declared with `exports`,
  // SQLite-backed as every new Durable Object must be; Wrangler would let an
  // environment inherit both, so each environment declares them again.
  "durable_objects": {
    "bindings": [{ "name": "QUOTA_COUNTER", "class_name": "QuotaCounter" }],
  },
  "exports": {
    "QuotaCounter": { "type": "durable-object", "storage": "sqlite" },
  },
  // The public media (ADR 0011): an R2 bucket of content people or the admin
  // upload, by prefix (business photos under photos/), which Cloudflare serves
  // from the media hostname (MEDIA_URL) without the Worker. Production has its
  // own; dev and stage share one. Locally the bucket is Miniflare's, in
  // .wrangler/state, and the local Worker serves it under /_media/
  // (src/lib/photos.ts).
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "enmirumbo-media-local" }],
  // Cloudflare Images (ADR 0011): the registration transforms an uploaded
  // photo into the two WebP variants it stores in MEDIA
  // (src/core/photos/upload.ts). Locally, and in the tests, Wrangler runs an
  // offline version with sharp; a deployed environment uses the real service.
  "images": { "binding": "IMAGES" },
  "vars": {
    // local, dev, stage or prod. Only "local" lets /admin open with the fixed
    // identity admin@enmirumbo.test, and only on a loopback host (ADR 0010).
    // Every other value sends X-Robots-Tag: noindex and a closed robots.txt.
    "ENVIRONMENT": "local",
    // Cloudflare Access: the team domain and the AUD tag of the admin
    // application. Locally the panel does not check them.
    "ACCESS_TEAM_DOMAIN": "urekz.cloudflareaccess.com",
    "ACCESS_AUD": "",
    // The public URL of the site, without a trailing slash: the base of every
    // absolute URL (canonicals, sitemap, share previews).
    "SITE_URL": "http://localhost:4321",
    // The https origin of the media hostname (ADR 0011), where the business
    // photos are served from: the only other origin the content security
    // policy lets images come from. Empty locally: no media hostname; the
    // local Worker serves the local bucket on its own origin instead.
    "MEDIA_URL": "",
    // The Website ID of the site at Umami Cloud (ADR 0014). Only prod ever
    // loads the measurement, and only with a Website ID; empty everywhere
    // until the launch, so nothing is measured and no request leaves the site.
    "UMAMI_WEBSITE_ID": "",
    // The public site key of the Turnstile widget of the registration and edit
    // forms (ADR 0012). Locally, Cloudflare's always-pass test site key, whose
    // dummy token only the local Worker accepts (src/core/turnstile/).
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
  },
  // The Worker secrets, which Wrangler does not inherit: each environment
  // lists them again, and its deploy uploads them (scripts/deploy/
  // deploy-worker.sh). Locally none is needed: without TURNSTILE_SECRET_KEY the
  // local Worker emulates Turnstile's always-pass test secret, and a
  // .dev.vars file may set another test secret.
  "secrets": { "required": ["TURNSTILE_SECRET_KEY"] },
  "env": {
    // Deployed by hand from any branch (deploy-dev.yml). Its database is reset
    // from stage on every deploy.
    "dev": {
      "name": "dev-enmirumbo",
      "workers_dev": true,
      "preview_urls": false,
      // Workers Logs and traces off, as at the top level.
      "observability": {
        "enabled": false,
        "logs": { "enabled": false, "invocation_logs": false, "persist": false },
        "traces": { "enabled": false, "persist": false },
      },
      // No Cron Trigger on dev (ADR 0013). The empty list also removes any
      // trigger left on the Worker; omitting it would keep them.
      "triggers": { "crons": [] },
      // The Hyperdrive configs enmirumbo-dev (cached) and enmirumbo-dev-fresh
      // (caching disabled), both on this environment's Neon branch.
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "0a3272c97e4d4fc98be93810797b2da3" },
        { "binding": "HYPERDRIVE_FRESH", "id": "e54b23629d3d4b5491020a29a4b041fd" },
      ],
      "durable_objects": {
        "bindings": [{ "name": "QUOTA_COUNTER", "class_name": "QuotaCounter" }],
      },
      "exports": {
        "QuotaCounter": { "type": "durable-object", "storage": "sqlite" },
      },
      // The public media: the bucket and hostname it shares with stage, whose database dev copies.
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "enmirumbo-media-dev" }],
      // Cloudflare Images, which transforms the uploaded photos.
      "images": { "binding": "IMAGES" },
      "vars": {
        "ENVIRONMENT": "dev",
        "ACCESS_TEAM_DOMAIN": "urekz.cloudflareaccess.com",
        // The AUD tag of the "enmirumbo admin" Access application, the same in
        // the three environments (ADR 0010).
        "ACCESS_AUD": "a98a5e8ae63966e34ec201af51ec9b15ba202afaee4768ddb940bcb016ad2338",
        "SITE_URL": "https://dev-enmirumbo.urekz.workers.dev",
        // The media hostname (ADR 0011), under urekz.com until enmirumbo.com
        // moves to Cloudflare.
        "MEDIA_URL": "https://media-dev-enmirumbo.urekz.com",
        // Never measured (ADR 0014): only prod loads Umami.
        "UMAMI_WEBSITE_ID": "",
        // The public site key of the Turnstile widget enmirumbo-dev (managed,
        // for the dev and stage hostnames), which dev and stage share. The
        // deploy refuses a placeholder and a test key.
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFaqXxFK2fa7EiS4",
        // The branch and commit deployed, shown in the page footer of dev only.
        // deploy-dev.yml sets them with `wrangler deploy --var`.
        "DEPLOY_BRANCH": "",
        "DEPLOY_COMMIT": "",
      },
      "secrets": { "required": ["TURNSTILE_SECRET_KEY"] },
    },
    // Deployed on every push to main (deploy-stage.yml).
    "stage": {
      "name": "stage-enmirumbo",
      "workers_dev": true,
      "preview_urls": false,
      // Workers Logs and traces off, as at the top level.
      "observability": {
        "enabled": false,
        "logs": { "enabled": false, "invocation_logs": false, "persist": false },
        "traces": { "enabled": false, "persist": false },
      },
      // The hourly job (ADR 0013).
      "triggers": { "crons": ["0 * * * *"] },
      // The Hyperdrive configs enmirumbo-stage (cached) and enmirumbo-stage-fresh
      // (caching disabled), both on this environment's Neon branch.
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "5eb632efe8ec4ae7acb051de4fbfbdc0" },
        { "binding": "HYPERDRIVE_FRESH", "id": "1c9b85b07a3d4df2811c2ec83046ecec" },
      ],
      "durable_objects": {
        "bindings": [{ "name": "QUOTA_COUNTER", "class_name": "QuotaCounter" }],
      },
      "exports": {
        "QuotaCounter": { "type": "durable-object", "storage": "sqlite" },
      },
      // The public media: the bucket and hostname it shares with dev.
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "enmirumbo-media-dev" }],
      // Cloudflare Images, which transforms the uploaded photos.
      "images": { "binding": "IMAGES" },
      "vars": {
        "ENVIRONMENT": "stage",
        "ACCESS_TEAM_DOMAIN": "urekz.cloudflareaccess.com",
        // The AUD tag of the "enmirumbo admin" Access application, the same in
        // the three environments (ADR 0010).
        "ACCESS_AUD": "a98a5e8ae63966e34ec201af51ec9b15ba202afaee4768ddb940bcb016ad2338",
        "SITE_URL": "https://stage-enmirumbo.urekz.workers.dev",
        // The media hostname (ADR 0011), under urekz.com until enmirumbo.com
        // moves to Cloudflare.
        "MEDIA_URL": "https://media-dev-enmirumbo.urekz.com",
        // Never measured (ADR 0014): only prod loads Umami.
        "UMAMI_WEBSITE_ID": "",
        // The public site key of the Turnstile widget enmirumbo-dev (managed,
        // for the dev and stage hostnames), which dev and stage share. The
        // deploy refuses a placeholder and a test key.
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFaqXxFK2fa7EiS4",
      },
      "secrets": { "required": ["TURNSTILE_SECRET_KEY"] },
    },
    // Production, deployed from a tag vX.Y.Z (deploy-prod.yml).
    "prod": {
      "name": "enmirumbo",
      "workers_dev": true,
      "preview_urls": false,
      // Workers Logs and traces off, as at the top level.
      "observability": {
        "enabled": false,
        "logs": { "enabled": false, "invocation_logs": false, "persist": false },
        "traces": { "enabled": false, "persist": false },
      },
      // The hourly job (ADR 0013).
      "triggers": { "crons": ["0 * * * *"] },
      // The Hyperdrive configs enmirumbo-prod (cached) and enmirumbo-prod-fresh
      // (caching disabled), both on this environment's Neon branch.
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "9c3586cc9df74be2b745eccd83efb81b" },
        { "binding": "HYPERDRIVE_FRESH", "id": "6759de1d09dc48229664e712f38fee30" },
      ],
      "durable_objects": {
        "bindings": [{ "name": "QUOTA_COUNTER", "class_name": "QuotaCounter" }],
      },
      "exports": {
        "QuotaCounter": { "type": "durable-object", "storage": "sqlite" },
      },
      // The public media: its own bucket and hostname, which no other environment reaches.
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "enmirumbo-media" }],
      // Cloudflare Images, which transforms the uploaded photos.
      "images": { "binding": "IMAGES" },
      "vars": {
        "ENVIRONMENT": "prod",
        "ACCESS_TEAM_DOMAIN": "urekz.cloudflareaccess.com",
        // The AUD tag of the "enmirumbo admin" Access application, the same in
        // the three environments (ADR 0010).
        "ACCESS_AUD": "a98a5e8ae63966e34ec201af51ec9b15ba202afaee4768ddb940bcb016ad2338",
        "SITE_URL": "https://enmirumbo.urekz.workers.dev",
        // The media hostname (ADR 0011), under urekz.com until enmirumbo.com
        // moves to Cloudflare.
        "MEDIA_URL": "https://media-enmirumbo.urekz.com",
        // Measurement stays off until the launch: the Website ID arrives with
        // the cut-over (ADR 0014).
        "UMAMI_WEBSITE_ID": "",
        // The public site key of the Turnstile widget enmirumbo (managed, for
        // the production hostname). The deploy refuses a placeholder and a
        // test key.
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFaqP_qD38iv_oZ6",
      },
      "secrets": { "required": ["TURNSTILE_SECRET_KEY"] },
    },
  },
}
